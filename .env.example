# ─── Flask ─────────────────────────────────────────────
# Секретный ключ сессий. В продакшене — длинная случайная строка!
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-please-0123456789abcdef
FLASK_ENV=production

# ─── База данных ───────────────────────────────────────
# Вариант для Docker Compose (PostgreSQL):
DATABASE_URL=postgresql://crm:crm_password_change_me@db:5432/crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_password_change_me
POSTGRES_DB=crm

# Вариант для локального запуска БЕЗ Docker (SQLite):
# DATABASE_URL=sqlite:///crm.db

# ─── Приложение ────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=5000
# Домен твоего сайта (для Nginx и cookies). Пример: crm.mysite.ru
DOMAIN=localhost
